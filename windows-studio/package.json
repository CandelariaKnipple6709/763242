{
  "name": "camswap-studio",
  "version": "1.0.0",
  "description": "camswap studio — desktop app for uploading/editing scenes and pairing with the iOS app via QR code (embeds its own signaling server, no separate node process needed).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.camswap.studio",
    "productName": "CamSwap Studio",
    "files": [
      "main.js",
      "preload.js",
      "signaling.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
